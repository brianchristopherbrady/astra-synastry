# Local dev DB (SQLite file, zero setup). Swap to a Postgres URL + change the
# provider in prisma/schema.prisma back to "postgresql" for production use.
DATABASE_URL="file:./dev.db"

# AI providers (server-side only, never exposed to client)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
